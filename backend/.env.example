# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# api | worker | all   (all runs both in one process for Railway free tier)
START_MODE=all

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# Local: postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
# Prod:  Neon pooled connection string
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# ─────────────────────────────────────────────
# Redis (with AOF persistence)
# Local: redis://localhost:6379
# Prod:  Railway Redis URL
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Elasticsearch 8
# Local: http://localhost:9200  (security disabled in docker-compose)
# Prod:  Elastic Cloud URL + API key
# ─────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ─────────────────────────────────────────────
# Worker settings
# ─────────────────────────────────────────────
# Number of concurrent jobs per worker process
WORKER_CONCURRENCY=5
# Minimum milliseconds between sends from the same sender (Redis slot reservation)
MIN_DELAY_MS=1000
# Hard ceiling on emails per sender per UTC hour (env trumps campaign/sender settings)
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Random jitter added to each email's scheduled_at (avoids thundering herd)
SEND_JITTER_MS=500

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
# At least 32 random characters for JWT signing
JWT_SECRET=replace_me_with_32_plus_random_chars

# 64-character hex string (= 32 bytes) for AES-256-GCM encryption of secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_me_with_64_hex_chars_0000000000000000000000000000000000

# ─────────────────────────────────────────────
# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://your-vercel-domain.vercel.app/api/auth/google/callback
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─────────────────────────────────────────────
# Slack OAuth
# Create at: https://api.slack.com/apps
# OAuth redirect URL: https://your-vercel-domain.vercel.app/api/slack/callback
# Scope: incoming-webhook
# ─────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ─────────────────────────────────────────────
# Bull Board (HTTP Basic Auth)
# Access at: http://localhost:4000/admin/queues
# ─────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme123

# ─────────────────────────────────────────────
# CORS / redirects
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
